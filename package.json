{
	"name": "adventure-game-builder",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"workspaces": [
		"apps/asset-studio",
		"packages/asset-compiler-contract",
		"packages/character-contract",
		"packages/three-asset-preview"
	],
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"dev:asset-studio": "npm --workspace @adventure-game-builder/asset-studio run dev",
		"build": "tsc --noEmit && vite build",
		"build:asset-studio": "npm --workspace @adventure-game-builder/asset-studio run build",
		"build:contracts": "npm --workspace @adventure-game-builder/character-contract run build && npm --workspace @adventure-game-builder/asset-compiler-contract run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:asset-studio": "npm --workspace @adventure-game-builder/asset-studio run test:run",
		"test:contracts": "npm --workspace @adventure-game-builder/character-contract run test:run && npm --workspace @adventure-game-builder/asset-compiler-contract run test:run",
		"test:retarget-spike": "node --test tools/animation-retargeting/*.test.mjs",
		"test:blender-bake": "node --test tools/blender-character/*.test.mjs",
		"test:procedural-mannequin": "node --test tools/blender-character/procedural-mannequin.test.mjs",
		"bake:golden-animation": "node tools/blender-character/golden-animation-bake.mjs",
		"compile:procedural-mannequin": "node tools/blender-character/procedural-mannequin-compiler.mjs",
		"validate:golden-animation-bakes": "node tools/blender-character/offline-bake-roundtrip.mjs",
		"validate:procedural-mannequin": "node tools/blender-character/procedural-mannequin-compiler.mjs --validate-only",
		"validate:procedural-topology-matrix": "node tools/blender-character/procedural-mannequin-topology-matrix.mjs",
		"validate:procedural-appearance-matrix": "node tools/blender-character/procedural-mannequin-appearance-matrix.mjs",
		"validate:procedural-hairstyle-matrix": "node tools/blender-character/procedural-mannequin-hairstyle-matrix.mjs",
		"validate:golden-animation-sources": "node tools/animation-retargeting/validate-source-provenance.mjs",
		"check:asset-studio": "npm run build:contracts && npm run test:contracts && npm --workspace @adventure-game-builder/asset-studio run check",
		"test:e2e": "playwright test",
		"test:e2e:three-perf": "playwright test e2e/three-perf-smoke.spec.ts",
		"test:e2e:asset-studio": "playwright test -c apps/asset-studio/playwright.config.ts",
		"test:e2e:headed": "playwright test --headed",
		"ci": "npm run typecheck && npm run test:run && npm run build",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"@vitejs/plugin-react": "^4.3.4",
		"@adventure-game-builder/three-asset-preview": "0.1.0",
		"phaser": "^3.87.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"three": "^0.184.0",
		"vite": "^6.0.5",
		"zustand": "^5.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@playwright/test": "^1.61.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.184.1",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^16.4.0",
		"typescript": "^5.7.2",
		"vitest": "^4.1.7"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css}": [
			"biome check --write"
		]
	}
}
