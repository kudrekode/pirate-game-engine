{
	"name": "adventure-game-builder",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"workspaces": [
		"apps/asset-studio",
		"packages/asset-compiler-contract",
		"packages/character-contract"
	],
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"dev:asset-studio": "npm --workspace @adventure-game-builder/asset-studio run dev",
		"build": "tsc --noEmit && vite build",
		"build:asset-studio": "npm --workspace @adventure-game-builder/asset-studio run build",
		"build:contracts": "npm --workspace @adventure-game-builder/character-contract run build && npm --workspace @adventure-game-builder/asset-compiler-contract run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:asset-studio": "npm --workspace @adventure-game-builder/asset-studio run test:run",
		"test:contracts": "npm --workspace @adventure-game-builder/character-contract run test:run && npm --workspace @adventure-game-builder/asset-compiler-contract run test:run",
		"check:asset-studio": "npm run build:contracts && npm run test:contracts && npm --workspace @adventure-game-builder/asset-studio run check",
		"test:e2e": "playwright test",
		"test:e2e:three-perf": "playwright test e2e/three-perf-smoke.spec.ts",
		"test:e2e:headed": "playwright test --headed",
		"ci": "npm run typecheck && npm run test:run && npm run build",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"@vitejs/plugin-react": "^4.3.4",
		"phaser": "^3.87.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"three": "^0.184.0",
		"vite": "^6.0.5",
		"zustand": "^5.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@playwright/test": "^1.61.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.184.1",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^16.4.0",
		"typescript": "^5.7.2",
		"vitest": "^4.1.7"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css}": [
			"biome check --write"
		]
	}
}
